# Use a PyTorch image with CUDA 12.4 devel tools preinstalled (required for compiling Mamba SSM)
FROM pytorch/pytorch:2.4.0-cuda12.4-cudnn9-devel

# Set non-interactive timezone/locale installation
ENV DEBIAN_FRONTEND=noninteractive \
    PATH=/usr/local/cuda/bin:$PATH \
    LD_LIBRARY_PATH=/usr/local/cuda/lib64:$LD_LIBRARY_PATH \
    MUJOCO_GL=egl

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    git \
    curl \
    wget \
    libglib2.0-0 \
    libgl1-mesa-glx \
    libegl1-mesa-dev \
    ffmpeg \
    pkg-config \
    libusb-1.0-0-dev \
    cmake \
    ninja-build \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install build dependencies for Mamba SSM
RUN pip install --no-cache-dir packaging ninja

# Install causal-conv1d and mamba-ssm from source/wheels
# Using --no-build-isolation allows it to compile using the preinstalled PyTorch/CUDA setup
RUN pip install --no-cache-dir causal-conv1d>=1.4.0 --no-build-isolation
RUN pip install --no-cache-dir mamba-ssm==2.2.0 --no-build-isolation

# Create the /home/zozo folder to maintain path compatibility with hardcoded references
WORKDIR /home/zozo

# Copy the repositories into the container under /home/zozo
# This ensures that "/home/zozo/roboMamba/src" is found correctly by lerobot policies
COPY lerobot /home/zozo/lerobot
COPY roboMamba /home/zozo/roboMamba
COPY leisaac /home/zozo/leisaac

# Install roboMamba requirements (excluding torch packages to avoid overwriting CUDA 12 torch)
RUN pip install --no-cache-dir \
    accelerate==0.33.0 \
    pandas==2.2.2 \
    peft==0.12.0 \
    pillow==10.2.0 \
    scikit-learn==1.5.1 \
    scipy==1.13.1 \
    seaborn==0.13.2 \
    sympy==1.12 \
    timm==1.0.7 \
    transformers==4.43.3 \
    triton==2.1.0 \
    wandb==0.17.8

# Install lerobot in editable/develop mode
WORKDIR /home/zozo/lerobot
RUN pip install --no-cache-dir -e ".[all]"

# Install leisaac with lerobot extras in editable mode
WORKDIR /home/zozo/leisaac
RUN pip install --no-cache-dir -e "source/leisaac[lerobot]"

# Set working directory back to leisaac root for easy script execution
WORKDIR /home/zozo/leisaac

# Default command
CMD ["/bin/bash"]
